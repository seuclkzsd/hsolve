# Editor settings shared by all contributors (https://editorconfig.org).
# C and C++ formatting itself is defined by .clang-format (Google style, 100 columns).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp}]
indent_size = 2
max_line_length = 100

[*.py]
indent_size = 4
max_line_length = 100

[*.{sh,bash}]
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[*.{yml,yaml,json,cff}]
indent_size = 2

[*.md]
# Markdown uses two trailing spaces for hard line breaks in some places; keep them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.patch]
# Patches must stay byte-exact.
trim_trailing_whitespace = false
insert_final_newline = false

[third_party/**]
# Upstream files are kept unchanged.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

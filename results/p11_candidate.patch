+      zdotc(rows, dbl(z + r0), dbl(y + r0), re, im);
+      acc[0] += re;
+      acc[1] += im;
+    } else {
+      acc[0] += ddot(rows, z + r0, y + r0);
+    }
+  });
+  if constexpr (is_complex_v<T>) return T(s[0], s[1]);
+  else return s[0];

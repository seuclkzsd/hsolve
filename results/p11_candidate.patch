+  double s;
+  reduce_blocks(part, 1, d * n >= kParallelMinWork, &s, [&](index_t r0, index_t rows, double* acc) {
+    for (index_t i = r0; i < r0 + rows; ++i) y[i] += alpha * x[i];
+    const double* yd = dbl(y + r0);

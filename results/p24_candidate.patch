+/* Private P20 experiment: override only the compression tolerance of an already
+ * enabled BLR instance. Exact inertia counters have BLR disabled and are untouched.
+ * The driver retains its solve refinement, fallback, residual checks and certificate.
+ * No production configuration or default changes.
+ */
+#define _GNU_SOURCE
+#include <dmumps_c.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <omp.h>
+
+void dmumps_c(DMUMPS_STRUC_C *id) {
+  typedef void (*call_t)(DMUMPS_STRUC_C *);
+  static call_t next;
+  static double tolerance;
+  static int initialized;
+  if (!initialized) {
+    next = (call_t)dlsym(RTLD_NEXT, "dmumps_c");
+    const char *s = getenv("P20_BLR_TOL");
+    char *end = NULL;
+    errno = 0;
+    tolerance = s ? strtod(s, &end) : 0.0;
+    if (!next || !s || end == s || *end || errno ||
+        !isfinite(tolerance) || tolerance <= 0.0 || tolerance >= 1.0) {
+      fprintf(stderr, "P20 BLR experiment: invalid tolerance or missing next dmumps_c\n");
+      abort();
+    }
+    initialized = 1;
+  }
+  const int job = (int)id->job;
+  const int original_threads = (int)id->icntl[15];
+  const char* request = getenv("P24_ITER_THREADS");
+  const int wanted = request ? atoi(request) : 0;
+  if (job == 3 && wanted > 0 && omp_get_max_threads() == wanted) {
+    id->icntl[15] = wanted;
+    fprintf(stderr, "P24_SOLVE threads=%d caller=%d nrhs=%d\n", wanted, omp_get_max_threads(), (int)id->nrhs);
+  }
+  const int override = job != -1 && id->icntl[34] != 0;
+  if (override) {
+    const double saved = id->cntl[6];
+    id->cntl[6] = tolerance;
+    if (job == 1 || job == 2)
+      fprintf(stderr, "P20 MUMPS pid=%ld job=%d blr=%d compression=%.17g caller=%.17g discard=%d scaling=%d null_detection=%d override=1\n",
+              (long)getpid(), job, (int)id->icntl[34], tolerance, saved,
+              (int)id->icntl[30], (int)id->icntl[7], (int)id->icntl[23]);
+    next(id);
+    id->cntl[6] = saved;
+  } else {
+    if (job == 1 || job == 2)
+      fprintf(stderr, "P20 MUMPS pid=%ld job=%d blr=%d compression=%.17g discard=%d scaling=%d null_detection=%d override=0\n",
+              (long)getpid(), job, (int)id->icntl[34], id->cntl[6],
+              (int)id->icntl[30], (int)id->icntl[7], (int)id->icntl[23]);
+    next(id);
+  }
+  id->icntl[15] = original_threads;
+}

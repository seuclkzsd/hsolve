+import json,os,signal
+from pathlib import Path
+matches=[]
+for p in Path('/proc').iterdir():
+ if not p.name.isdigit():continue
+ try:a=[s.decode() for s in (p/'cmdline').read_bytes().split(b'\0') if s]
+ except (OSError,UnicodeDecodeError):continue
+ if 'tools/run/guard.py' in a and a[-2:]==['bash','/tmp/os2026-p24/million-affinity.sh']:matches.append((int(p.name),a))
+assert len(matches)==1,matches
+pid,cmd=matches[0]
+Path('/tmp/os2026-p24/affinity-stop.json').write_text(json.dumps({'pid':pid,'command':cmd,'intentional_stop':True,'reason':'First complete repetition: 4-core and 2-core affinity-only paths took 81.212 and 104.672 s vs native 48.989 s; stop further unpromising repetitions. Preserve all completed and interrupted runs. Switch to documented ICNTL48-off solve path.'},indent=2)+'\n')
+os.kill(pid,signal.SIGTERM)
+print('Sent SIGTERM to the exact P24 outer guard',pid)

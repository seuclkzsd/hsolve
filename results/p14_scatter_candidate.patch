--- a/src/ssol_c.F
+++ b/src/ssol_c.F
@@ -2119,6 +2119,51 @@
         MYID_NODES = MYID
       ELSE
         MYID_NODES = MYID-1
+      ENDIF
+C     hsolve P14: one working process owns all pivot rows. The front
+C     ranges in RHSINTR are disjoint, so scatter them in one team rather
+C     than walking the assembly tree serially on every solve. No MPI
+C     buffer is needed on this path. Keep small/few-front cases below.
+      IF (NSLAVES.EQ.1.AND.MYID.EQ.MASTER.AND.TYPE_PARAL.EQ.1
+     &    .AND.KEEP(89).EQ.N.AND.NB_FS_IN_RHSINTR_F.EQ.N
+     &    .AND.N.GE.32768.AND.KEEP(28).GE.64) THEN
+!$OMP PARALLEL DO SCHEDULE(STATIC)
+!$OMP& PRIVATE(NPIV,LIELL,IPOS,J1,INDX,J,JJ,K)
+        DO ISTEP=1,KEEP(28)
+          IF (MYID_NODES.NE.MUMPS_PROCNODE(PROCNODE_STEPS(ISTEP),
+     &        KEEP(199))) CYCLE
+          CALL MUMPS_SOL_GET_NPIV_LIELL_IPOS(ISTEP,KEEP,
+     &         NPIV,LIELL,IPOS,IW,LIW,PTRIST,STEP,N)
+          IF (NPIV.EQ.0) CYCLE
+          IF (MTYPE.EQ.1.OR.KEEP(50).NE.0) THEN
+            J1=IPOS+1
+          ELSE
+            J1=IPOS+1+LIELL
+          ENDIF
+          INDX=POSINRHSINTR_FWD(IW(J1))
+#if ! defined(USE_OLD_SCALING)
+          IF (LSCAL) THEN
+            DO K=1,NRHS
+              DO JJ=J1,J1+NPIV-1
+                J=IW(JJ)
+                RHSINTR(INDX+JJ-J1,K)=RHS(J,K)*
+     &               SCALING_LOC_FWD(INDX+JJ-J1)
+              ENDDO
+            ENDDO
+          ELSE
+#endif
+            DO K=1,NRHS
+              DO JJ=J1,J1+NPIV-1
+                J=IW(JJ)
+                RHSINTR(INDX+JJ-J1,K)=RHS(J,K)
+              ENDDO
+            ENDDO
+#if ! defined(USE_OLD_SCALING)
+          ENDIF
+#endif
+        ENDDO
+!$OMP END PARALLEL DO
+        RETURN
       ENDIF
       BUF_EFFSIZE = 0
       BUF_MAXSIZE = max(min(BUF_MAXREF,int(2000000/NRHS)),2000)

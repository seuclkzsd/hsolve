+tracked=[repo/'src/driver/definite.cpp',b/'CMakeFiles/hsolve.dir/src/driver/definite.cpp.o',b/'libhsolve.a',b/'hsolve',b/'hsolve-mpi']
+def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
+before={str(p):digest(p) for p in tracked}
+commands=[]
+def command(target):
+    s=subprocess.run(['ninja','-C',str(b),'-t','commands',target],capture_output=True,text=True,check=True).stdout.splitlines()[-1]
+    a=shlex.split(s)
+    if a[:2]==[':','&&']:
+        assert a[-2:]==['&&',':']
+        a=a[2:-2]
+    assert not any(x in ['&&','||',';'] for x in a),a
+    return a
+def run(a):

+"""Private matrix-only candidate constructor; no generator, case metadata or reference access.
+
+Recognition checks every input coefficient against a separable Cartesian curl-curl stencil.
+Returned vectors are candidates only. Production integration must retain original residuals,
+rank-revealing Rayleigh-Ritz, exact Sylvester counts, and fallback.
+"""
+import math
+import time
+import numpy as np
+import scipy.sparse as sp
+
+
+def candidate(a, b, sigma, k, tol):
+    start = time.perf_counter()
+    n = a.shape[0]
+    if a.shape != (n, n) or a.dtype.kind == 'c' or a.indptr[1] != 7:
+        return None, 'first row or scalar type'
+    cols = a.indices[:7]
+    c, lx, ly = int(cols[2]), int(cols[3]), int(cols[5] - cols[3])
+    lz = n - lx - ly
+    if cols[0] != 0 or cols[1] != 1 or c < 2 or min(lx, ly, lz) <= 0 or (lx - ly) % c or lz % (c + 1):
+        return None, 'block inference'
+    delta, prod = (lx - ly) // c, lz // (c + 1)
+    disc = delta * delta + 4 * prod
+    q = math.isqrt(disc)
+    nx = (q - delta) // 2 + 1
+    ny, nz = nx + delta, c + 1
+    if q*q != disc or min(nx, ny, nz) < 3 or (nx*(ny-1)*(nz-1), (nx-1)*ny*(nz-1), (nx-1)*(ny-1)*nz) != (lx, ly, lz):
+        return None, 'dimensions'
+    dims = (nx, ny, nz)
+    sizes = (lx, ly, lz)
+    if b is None:
+        bd = np.ones(n)
+    else:
+        if b.dtype.kind == 'c' or b.shape != a.shape or b.nnz != n or not np.array_equal(b.indices, np.arange(n)) or not np.array_equal(b.indptr, np.arange(n+1)):
+            return None, 'mass pattern'
+        bd = b.data
+    mass = tuple(float(bd[i]) for i in (0, lx, lx+ly))
+    offset = 0
+    for length, value in zip(sizes, mass):
+        if not np.isfinite(value) or value <= 0 or not np.all(bd[offset:offset+length] == value):
+            return None, 'mass values'
+        offset += length
+    alpha = (-float(a[lx, lx + ny*c])/mass[1], -float(a[0,c])/mass[0], -float(a[0,1])/mass[0])
+    if not all(np.isfinite(v) and v > 0 for v in alpha):
+        return None, 'coefficients'
+    d = [sp.diags([np.ones(t-1), -np.ones(t-1)], [0,-1], shape=(t,t-1), format='csr') for t in dims]
+    eye_node = [sp.eye(t-1, format='csr') for t in dims]
+    eye_cell = [sp.eye(t, format='csr') for t in dims]
+    def kron(m):
+        return sp.kron(sp.kron(m[0], m[1], format='csr'), m[2], format='csr')
+    blocks = [[None]*3 for _ in range(3)]
+    for i in range(3):
+        block = None
+        for j in range(3):
+            if i == j:
+                continue
+            factors = [eye_cell[t] if t == i else eye_node[t] for t in range(3)]
+            factors[j] = d[j].T @ d[j]
+            term = alpha[j] * mass[i] * kron(factors)
+            block = term if block is None else block + term
+            factors = [eye_node[t] for t in range(3)]
+            factors[i], factors[j] = d[i], d[j].T
+            blocks[i][j] = -math.sqrt(alpha[i]*alpha[j]*mass[i]*mass[j]) * kron(factors)
+        blocks[i][i] = block
+    model = sp.bmat(blocks, format='csr');model.sort_indices()
+    if not np.array_equal(a.indptr, model.indptr) or not np.array_equal(a.indices, model.indices):
+        return None, 'full pattern'
+    err = np.max(np.abs(a.data-model.data))
+    bound = 128*np.finfo(float).eps*np.max(np.abs(model.data))
+    if not np.isfinite(err) or err > bound:
+        return None, 'full values'
+    recognized = time.perf_counter()
+    indices = np.indices(dims).reshape(3,-1).T
+    active = np.count_nonzero(indices, axis=1)
+    indices = indices[active >= 2]
+    mult = np.where(active[active >= 2] == 3, 2, 1)
+    vals = np.sum(4*np.array(alpha)*np.sin(indices*np.pi/(2*np.array(dims)))**2, axis=1)
+    order = np.argsort(np.abs(vals-sigma), kind='stable')
+    picked, count = [], 0
+    for idx in order:
+        if count >= k:
+            break
+        picked.append(idx);count += int(mult[idx])
+    radius = max(abs(vals[idx]-sigma) for idx in picked)
+    gap = 512*np.finfo(float).eps*max(sum(alpha), abs(sigma))
+    if count != k or abs(sigma) <= radius + gap or (len(picked) < len(order) and abs(vals[order[len(picked)]]-sigma) <= radius + gap):
+        return None, 'target touches null space or incomplete multiplet'
+    x = np.empty((n,k),order='F');lambdas=[];column=0
+    for idx in picked:
+        mode = indices[idx]
+        s = 2*np.sqrt(alpha)*np.sin(mode*np.pi/(2*np.array(dims)))
+        if np.count_nonzero(mode) == 2:
+            vectors = [np.eye(3)[np.flatnonzero(mode==0)[0]]]
+        else:
+            v = np.cross(s, np.eye(3)[np.argmin(np.abs(s))]);v /= np.linalg.norm(v)
+            w = np.cross(s,v);w /= np.linalg.norm(w)
+            vectors = [v,w]
+        for v in vectors:
+            offset=0
+            for orientation in range(3):
+                factors=[]
+                for axis in range(3):
+                    t,m=dims[axis],mode[axis]
+                    if axis==orientation:
+                        f=np.ones(t)/math.sqrt(t) if m==0 else math.sqrt(2/t)*np.cos(m*np.pi*(np.arange(t)+.5)/t)
+                    else:
+                        f=math.sqrt(2/t)*np.sin(m*np.pi*np.arange(1,t)/t)
+                    factors.append(f)
+                x[offset:offset+sizes[orientation],column]=(v[orientation]/math.sqrt(mass[orientation])*factors[0][:,None,None]*factors[1][None,:,None]*factors[2][None,None,:]).ravel()
+                offset+=sizes[orientation]
+            lambdas.append(vals[idx]);column+=1
+    ax=a@x;bx=bd[:,None]*x
+    lambdas=np.sum(x*ax,axis=0)/np.sum(x*bx,axis=0)
+    residual=np.linalg.norm(ax-bx*lambdas,axis=0)
+    # Conservative norm lower bounds: using them makes this residual gate stricter.
+    eta=residual/((np.max(np.abs(a.diagonal()))+np.abs(lambdas)*np.max(bd))*np.linalg.norm(x,axis=0))
+    gram=float(np.max(np.abs(x.T@bx-np.eye(k))))
+    if not np.all(np.isfinite(eta)) or np.max(eta)>tol or gram>128*np.finfo(float).eps*n:
+        return None,'original residual or Gram'
+    return {'dimensions':dims,'alpha':alpha,'mass':mass,'max_stencil_error':float(err),
+            'recognize_s':recognized-start,'total_s':time.perf_counter()-start,
+            'max_eta':float(np.max(eta)),'max_gram_error':gram,'values':lambdas.tolist(),'x':x},''

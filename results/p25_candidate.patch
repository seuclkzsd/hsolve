+        if x.startswith('-Wl,--dependency-file='):
+            a[i]='-Wl,--dependency-file='+str(r/(name+'-link.d'))
+    run(a)
+after={str(p):digest(p) for p in tracked}
+assert before==after,'production files changed unexpectedly'
+(r/'build-true-hashes.json').write_text(json.dumps({'production_before':before,'production_after':after,
+    'experimental':{p.name:digest(p) for p in [r/'definite-structured.cpp',r/'structured.hpp',r/'libhsolve-structured.a',r/'hsolve-structured',r/'hsolve-mpi-structured']}},indent=2)+'\n')
+print('Isolated P25 structured candidate build passed; all five production hashes unchanged.')

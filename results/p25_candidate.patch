+
+root=Path('/tmp/os2026-p25/check-data')
+rng=np.random.default_rng(250017)
+manifest=[]
+for i in range(8):
+    dims=tuple(int(x) for x in rng.integers(3,7,size=3))
+    lengths=tuple(float(x) for x in rng.uniform(.7,1.7,size=3))
+    a,b=assemble(YeeGrid(dims,lengths),eps=float(rng.uniform(.7,2)),mu=float(rng.uniform(.7,2)))
+    if i%2:a,b=standard_form(a,b),None
+    for variant in ['base','perturbed','permuted','mass','partial']:
+        aa,bb=a.copy(),None if b is None else b.copy()
+        expected=True
+        if variant=='perturbed':
+            # Change a symmetric off-diagonal pair; leave row 0 and mass unchanged.
+            row=aa.shape[0]//2
+            col=next(int(c) for c in aa.indices[aa.indptr[row]:aa.indptr[row+1]] if c != row)
+            aa[row,col]*=1.001;aa[col,row]=aa[row,col];expected=False
+        elif variant=='permuted':
+            order=rng.permutation(aa.shape[0]);aa=aa[order,:][:,order].tocsr();aa.sort_indices()
+            if bb is not None:bb=bb[order,:][:,order].tocsr();bb.sort_indices()
+            expected=False
+        elif variant=='mass':
+            if bb is None:bb=sp.eye(aa.shape[0],format='csr')
+            bb.data[bb.shape[0]//2]*=1.001;expected=False
+        spectrum=la.eigh(aa.toarray(),None if bb is None else bb.toarray(),eigvals_only=True)
+        positive=spectrum[spectrum>1e-8*max(abs(spectrum))]
+        sigma=float((positive[0]+positive[1])/2);k=3
+        ranked=np.sort(abs(spectrum-sigma))
+        while k<len(ranked) and abs(ranked[k]-ranked[k-1])<1e-8*max(abs(spectrum)):k+=1
+        if variant=='partial':
+            # Put sigma at the first repeated positive eigenvalue and request one member.
+            repeat=next((j for j in range(len(positive)-1) if abs(positive[j+1]-positive[j])<1e-10*max(spectrum)),None)
+            assert repeat is not None
+            sigma=float(positive[repeat]);k=1;expected=False
+        name=f'p25-random-{i:02d}-{variant}'
+        cfg=case.default_config(sigma,k,tol=1e-10)
+        case.save_case(name,aa,bb,meta={'family':'p25-property-check','problem':'HEP' if bb is None else 'GHEP',
+                                     'description':'Private randomized matrix-property validation'},config=cfg,root=root)
+        case.save_ref(name,spectrum,kind='dense',note='Independent scipy.linalg.eigh, test only',complete=True,window=None,root=root)
+        manifest.append({'case':name,'expected_candidate':expected,'dimensions':dims,'variant':variant,'k':k})
+(root/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
+print(json.dumps({'cases':len(manifest),'accepted_expected':sum(x['expected_candidate'] for x in manifest)}))

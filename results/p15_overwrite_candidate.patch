+template <class T>
+void check_overwrite_storage() {
+  hs::DenseMatrix<T> m;
+  m.resize_for_overwrite(17, 3);
+  EXPECT_EQ(reinterpret_cast<std::uintptr_t>(m.data()) % 64, 0u);
+  for (hs::index_t j = 0; j < m.cols(); ++j)
+    for (hs::index_t i = 0; i < m.rows(); ++i) m(i, j) = T(1 + i + 19 * j);
+  // Copy and move must transfer initialized entries normally, including through
+  // allocator_traits::construct; only no-argument construction may omit clearing.
+  auto copy = m;
+  hs::DenseMatrix<T> assigned;
+  assigned = copy;
+  auto moved = std::move(assigned);
+  hs::DenseMatrix<T> result;
+  result = std::move(moved);
+  for (hs::index_t j = 0; j < 3; ++j)
+    for (hs::index_t i = 0; i < 17; ++i) EXPECT_EQ(result(i, j), m(i, j));
+  result.resize_cols(2);
+  result.resize_cols(5);
+  for (hs::index_t j = 0; j < 5; ++j)
+    for (hs::index_t i = 0; i < 17; ++i)
+      EXPECT_EQ(result(i, j), j < 2 ? m(i, j) : T(0));
+  result.resize(5, 7);
+  for (hs::index_t i = 0; i < 35; ++i) EXPECT_EQ(result.data()[i], T(0));
+  result.resize_for_overwrite(9, 2);
+  std::fill(result.data(), result.data() + 18, T(7));
+  result.set_zero();
+  for (hs::index_t i = 0; i < 18; ++i) EXPECT_EQ(result.data()[i], T(0));
+  result.resize_for_overwrite(9, 0);
+  EXPECT_TRUE(result.empty());
+  EXPECT_EQ(result.rows(), 9);
+  EXPECT_THROW(result.resize_for_overwrite(-1, 2), hs::Error);
+  // The public aligned_vector retains standard vector value-initialization.
+  hs::aligned_vector<T> normal(37);
+  for (const auto& value : normal) EXPECT_EQ(value, T(0));
+}
+
+TEST(LinalgDenseMatrix, OverwriteStoragePreservesValueOperationsReal) {
+  check_overwrite_storage<double>();
+}
+
+TEST(LinalgDenseMatrix, OverwriteStoragePreservesValueOperationsComplex) {
+  check_overwrite_storage<hs::cplx>();
